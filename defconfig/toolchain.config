# Toolchain: Clang + LLD
# Using system clang 22 with LLD — let kernel auto-detect versions
CONFIG_CC_IS_CLANG=y
CONFIG_AS_IS_LLVM=y
CONFIG_LD_IS_LLD=y
CONFIG_CC_CAN_LINK=y
CONFIG_CC_CAN_LINK_STATIC=y

# ThinLTO: link-time optimization using Clang thin backend.
# Sultan and Optimistic kernels both use LTO. ThinLTO gives most of the
# binary size and performance benefits of full LTO with lower build time
# and fewer link-time issues. Kernel accounts for ~40% of CPU time on
# Android (Google AutoFDO blog), so codegen improvements compound.
CONFIG_LTO=y
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_LTO_NONE is not set

# CFI_CLANG is enabled in hardening.config — do not disable here.
# merge_config.sh applies fragments alphabetically, so toolchain.config
# would override hardening.config if it set CFI_CLANG=n. Leave it to
# hardening.config to avoid the conflict.

# BPF JIT always on
CONFIG_BPF_JIT_ALWAYS_ON=y

# Disable LLVM Polly — clang 22 removed these flags
# CONFIG_LLVM_POLLY is not set

# DEBUG_INFO_BTF is enabled in hardening.config — do not disable here.
# Same alphabetical merge order concern as CFI_CLANG above.
