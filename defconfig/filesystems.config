# Filesystems: exFAT and NTFS3 for USB OTG storage support
# Both are mainline in Linux 5.15 — just need enabling.
# Common use case: USB OTG with exFAT-formatted USB drives.

# exFAT: standard for >32GB SD cards and USB drives
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"

# NTFS3: new mainline NTFS driver (replaces ntfs-3g FUSE)
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_64BIT_CLUSTER=y
# CONFIG_NTFS3_LZX_XPRESS is not set

# F2FS: Flash-Friendly File System (used by Android /data)
# ChicKernel enables these for better flash storage performance.
# F2FS compression saves storage space on the 64/128GB variants.
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_COMPRESSION=y
# CONFIG_F2FS_IOSTAT is not set
# Unfair RWSEM: reduces read semaphore contention on F2FS
# (CAF-specific, improves multi-threaded I/O on eMMC/UFS)
CONFIG_F2FS_UNFAIR_RWSEM=y

# EROFS: Enhanced Read-Only File System for system/vendor partitions
# Used by modern Android A/B partition schemes for read-only mounts
CONFIG_EROFS_FS=y
# CONFIG_EROFS_FS_XATTR is not set
