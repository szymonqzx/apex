# ZRAM: compressed swap in RAM with ZSTD compression
# ZSTD gives ~3:1 compression ratio with low CPU overhead on A73/A53

CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_COMP_RESTRICT_INIT=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
# CONFIG_ZRAM_DEF_COMP_LZ4 is not set
# CONFIG_ZRAM_DEF_COMP_LZO is not set
CONFIG_ZRAM_DEF_COMP="zstd"

# Writeback to UFS for overflow (spills cold pages to fast storage)
CONFIG_ZRAM_WRITEBACK=y
# CONFIG_ZRAM_MEMORY_TRACKING is not set

# KSM: kernel same-page merging for deduplication
# Saves 5-7% RAM on Android by merging identical pages from different processes
CONFIG_KSM=y

# Transparent huge pages (madvise only — don't force)
CONFIG_TRANSPARENT_HUGEPAGE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Memory cgroups for per-process accounting
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_KMEM=y

# CMA for contiguous memory allocation (display/camera buffers)
CONFIG_CMA=y
CONFIG_CMA_DEBUGFS=y
CONFIG_CMA_AREAS=32

# Swap
CONFIG_SWAP=y

# Memory hotplug (for dynamic memory management)
CONFIG_MEMORY_HOTPLUG=y

# MGLRU: Multi-Gen LRU — improves page reclaim by tracking page
# generations instead of a single active/inactive list. Reduces
# thrashing and improves cold-app launch on low-RAM devices.
# From Optimistic Kernel (re-enabled MGLRU over SLMK).
# If CAF bengal-5.15 doesn't have the backport, olddefconfig drops it.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Required by KSM
CONFIG_MMU=y
