# Governor: apex per-cluster CPU governor with non-linear power curve
# and schedutil as fallback

# CPU frequency support (required by apex governor)
CONFIG_CPU_FREQ=y

# Apex governor (our custom governor — non-linear power curve, iowait
# boost, hysteresis, fast_switch, per-cluster auto-tuning, gaming mode)
CONFIG_CPU_FREQ_GOV_APEX=y
CONFIG_CPU_FREQ_DEFAULT_GOV_APEX=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set

# schedutil as secondary governor (switchable via sysfs)
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y

# Conservative and powersave for userspace selection
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y

# CPU frequency stats
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_TIMES=y

# Common governor framework (required by apex and schedutil)
CONFIG_CPU_FREQ_GOV_ATTR_SET=y
CONFIG_CPU_FREQ_GOV_COMMON=y

# Qualcomm hardware DVFS (EPSS with fast_switch)
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_ARM_QCOM_CPUFREQ_HW_DEBUG=m
# DCVS framework is in performance.config

# APEX control plane (state machine, watchdog, OOM immortal)
CONFIG_APEX=y
CONFIG_APEX_WATCHDOG=y
CONFIG_APEX_IMMORTAL=y

# APEX CPU input boost (touch-driven frequency boost, independent of governor)
CONFIG_APEX_CPU_BOOST=y

# APEX thermal uclamp cooling device (smooth frequency capping via EM)
CONFIG_APEX_THERMAL_UCLAMP=y
