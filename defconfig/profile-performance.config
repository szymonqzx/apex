# defconfig/profile-performance.config — Performance profile
# Compile-time settings for Performance profile variant.
# Runtime tunables are in apex_profiles.rc.
#
# Build: ./tools/build-kernel.sh chickernel_defconfig ksun.susfs --profile performance

# CPU: stock ceiling (no cap)
# CONFIG_APEX_PROFILE_BATTERY is not set
# CONFIG_APEX_PROFILE_BALANCED is not set
CONFIG_APEX_PROFILE_PERFORMANCE=y

# GPU: stock clock (no cap)
CONFIG_APEX_GPU_MAX_FREQ_PERFORMANCE=1260000000

# Thermal: raise sustained-perf trip +5°C (skin-temp trip UNTOUCHED)
CONFIG_APEX_THERMAL_TRIP_PERFORMANCE=y

# Scheduler: fast ramp-up, relaxed ramp-down
CONFIG_APEX_SCHED_UP_RATE_LIMIT_PERFORMANCE=1500
CONFIG_APEX_SCHED_DOWN_RATE_LIMIT_PERFORMANCE=20000

# Charge limit: 100% (opt-in, user accepts heat)
# Set at runtime via apex_profiles.rc → /proc/apex_charge/charge_limit_percent

# LTO: Full LTO for performance profile (best runtime perf, longer build)
# CONFIG_LTO_CLANG_THIN is not set
CONFIG_LTO_CLANG_FULL=y
