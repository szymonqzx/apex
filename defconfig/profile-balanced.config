# defconfig/profile-balanced.config — Balanced profile (default)
# Compile-time settings for Balanced profile variant.
# Runtime tunables are in apex_profiles.rc.
#
# Build: ./tools/build-kernel.sh chickernel_defconfig ksun.susfs --profile balanced

# CPU: stock ceiling (no cap)
# CONFIG_APEX_PROFILE_BATTERY is not set
CONFIG_APEX_PROFILE_BALANCED=y
# CONFIG_APEX_PROFILE_PERFORMANCE is not set

# GPU: stock clock (1260 MHz)
CONFIG_APEX_GPU_MAX_FREQ_BALANCED=1260000000

# Thermal: stock trip points
CONFIG_APEX_THERMAL_TRIP_BALANCED=y

# Scheduler: vendor default, nudged toward faster-down
CONFIG_APEX_SCHED_UP_RATE_LIMIT_BALANCED=10000
CONFIG_APEX_SCHED_DOWN_RATE_LIMIT_BALANCED=8000

# Charge limit: 90% default
# Set at runtime via apex_profiles.rc → /proc/apex_charge/charge_limit_percent

# LTO: ThinLTO (build times stay sane)
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set
