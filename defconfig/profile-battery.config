# defconfig/profile-battery.config — Battery profile
# Compile-time settings for Battery profile variant.
# Runtime tunables (schedutil ramp, WALT thresholds, GPU cap) are in
# apex_profiles.rc. These are the compile-time-only settings.
#
# Build: ./tools/build-kernel.sh chickernel_defconfig ksun.susfs --profile battery

# CPU: cap A73 cluster max freq at ~75% of ceiling
# On SM6225-AD, A73 stock ceiling is 2.8GHz → cap at ~2.1GHz
# This is done via cpufreq table at compile time — the config flag
# below tells the apex governor to enforce a lower default max.
CONFIG_APEX_PROFILE_BATTERY=y
# CONFIG_APEX_PROFILE_BALANCED is not set
# CONFIG_APEX_PROFILE_PERFORMANCE is not set

# GPU: cap Adreno max clock at ~85% (1071 MHz vs 1260 MHz stock)
# This is enforced at runtime via apex_profiles.rc, but we also
# set the compile-time default OPP ceiling lower.
CONFIG_APEX_GPU_MAX_FREQ_BATTERY=1071000000

# Thermal: stock trip points (no relaxation)
# Trip points are in thermald.conf, not defconfig — but we flag
# the profile so the kernel state machine knows the compile-time default.
CONFIG_APEX_THERMAL_TRIP_BATTERY=y

# Scheduler: relaxed ramp-up, fast ramp-down
# These are runtime sysfs knobs, but we set compile-time defaults too.
CONFIG_APEX_SCHED_UP_RATE_LIMIT_BATTERY=30000
CONFIG_APEX_SCHED_DOWN_RATE_LIMIT_BATTERY=5000

# Charge limit: 80% default for long-term cell health
# Set at runtime via apex_profiles.rc → /proc/apex_charge/charge_limit_percent

# LTO: ThinLTO for battery profile (smaller binary, less code → less power)
# Already set in toolchain.config, but explicitly here for clarity.
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set
