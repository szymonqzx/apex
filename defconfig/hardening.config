# Hardening: kernel security and exploit mitigation

# Memory protection
# DEVMEM is disabled in chickernel_defconfig (# CONFIG_DEVMEM is not set),
# which is more secure than STRICT_DEVMEM. No need to set STRICT_DEVMEM.
# If DEVMEM were enabled, these would apply:
# CONFIG_STRICT_DEVMEM=y
# CONFIG_IO_STRICT_DEVMEM=y
CONFIG_HARDENED_USERCOPY=y
# CONFIG_HARDENED_USERCOPY_FALLBACK is not set
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# SLAB hardening
# CONFIG_SLAB_MERGE_DEFAULT is not set
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y

# KASLR
CONFIG_RANDOMIZE_BASE=y
# CONFIG_RANDOMIZE_MODULE_REGION_FULL is not set

# Control-flow integrity
CONFIG_CFI_CLANG=y

# Module signing
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_PROTECT=y
CONFIG_MODULE_SIG_SHA256=y

# Disable userfaultfd (known exploitation primitive)
# CONFIG_USERFAULTFD is not set

# Seccomp
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# KASAN (debug only — disable for production)
# CONFIG_KASAN is not set

# Bug detection
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=-1
CONFIG_SOFTLOCKUP_DETECTOR=y

# Debug info (for crash dumps)
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_DEBUG_INFO_BTF=y

# LSM stack
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor,bpf,baseband_guard"

# Baseband Guard (anti-brick modem protection)
CONFIG_BBG=y
CONFIG_BBG_ALLOW_IN_RECOVERY=y
# CONFIG_BBG_BLOCK_BOOT is not set
# CONFIG_BBG_BLOCK_RECOVERY is not set
CONFIG_BBG_DOMAIN_PROTECTION=y
CONFIG_BBG_ANTI_SPOOF_DOMAIN=3

# kptr restriction (runtime: /proc/sys/kernel/kptr_restrict=2)
# The init.d script sets this at boot; the config just needs the sysctl available
