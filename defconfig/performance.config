# Performance: interconnect, DCVS, I/O, TCP, memory reclaim
# Features identified by performance review comparing against Sultan,
# blu_spark, ElementalX, and Franco kernels.

# ---- Interconnect: memory bandwidth voting ----
# The bengal interconnect driver does SMD-RPM bus voting. Without it,
# memory bandwidth is stuck at default — CPU and GPU stalls go unmitigated.
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_BENGAL=y
CONFIG_INTERCONNECT_QCOM_RPM=y
CONFIG_INTERCONNECT_QCOM_QOS_RPM=y

# ---- DCVS: Dynamic Clock and Voltage Scaling ----
# Hardware-assisted DVFS framework. Works with EPSS to provide
# sub-microsecond frequency transitions and bandwidth voting.
# NOTE: DCVS fast-path depends on RPMH (not available on bengal,
# which uses RPM_SMD). MEMLAT depends on PMU_LIB.
CONFIG_MSM_RPM_SMD=y
CONFIG_QCOM_PMU_LIB=y
CONFIG_QCOM_DCVS=y
CONFIG_QCOM_BWMON=y
CONFIG_QCOM_MEMLAT=y
CONFIG_QCOM_CX_IPEAK=y

# ---- I/O scheduler: BFQ + MQ_DEADLINE ----
# BFQ for latency-sensitive workloads (app launches, audio)
# MQ_DEADLINE as fallback for throughput-oriented workloads
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_MQ_DEADLINE=y

# ---- TCP congestion: BBR (default) + Westwood (switchable) ----
# BBR improves throughput on mobile networks by modeling bandwidth
# instead of relying on packet loss. Significant improvement for
# Wi-Fi and cellular on the SM6225 modem.
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_TCP_CONG="bbr"
# Westwood: better than BBR on poor/lossy 4G networks (per XDA analysis).
# Not default — switchable via: echo westwood > /proc/sys/net/ipv4/tcp_congestion_control
CONFIG_TCP_CONG_WESTWOOD=y

# ---- FQ (Fair Queue) packet scheduler ----
# Required companion for BBR — BBR performs best with FQ as the queuing
# discipline. Without FQ, BBR falls back to internal pacing which is less
# efficient. Standard since Linux 4.9.
CONFIG_NET_SCH_FQ=y

# ---- Memory: compaction + VM events ----
# COMPACTION is needed for transparent huge pages and memory reclaim
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y

# ---- F2FS I/O stats ----
# Enable I/O statistics for F2FS (disabled in chickernel, useful for debugging)
# CONFIG_F2FS_IOSTAT is not set

# ---- EROFS: already enabled but ensure pcpu kthread ----
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y

# ---- PSI (already in scheduler.config but ensure) ----
CONFIG_PSI=y

# ---- IRQ time accounting ----
CONFIG_IRQ_TIME_ACCOUNTING=y

# ---- CMA debug (for display/camera buffer debugging) ----
CONFIG_CMA_DEBUGFS=y
