# defconfig/apex-modern.config — Phase 2 config-level modern stack
# Applied on top of apex_defconfig for modern, optimized defaults.
# All changes are safe defaults or strict improvements.

# --- ZRAM: switch to zstd (3-5x better compression than lzo-rle) ---
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
CONFIG_ZRAM_DEF_COMP="zstd"
CONFIG_ZRAM_WRITEBACK=y

# --- TCP congestion: add BBR as module (not default until loaded) ---
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=m
CONFIG_DEFAULT_TCP_CONG="cubic"

# --- Clang ThinLTO: smaller binary, faster boot, no runtime change ---
# CONFIG_LTO_NONE is not set
CONFIG_LTO_CLANG_THIN=y

# --- SELinux: enforcing (remove permissive develop mode) ---
# CONFIG_SECURITY_SELINUX_DEVELOP is not set

# --- Debug info: DWARF5 + compressed (smaller, modern) ---
# CONFIG_DEBUG_INFO_DWARF4 is not set
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_COMPRESSED=y

# --- Function tracer: enable for perf and debugging ---
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y

# --- PSI: keep enabled (already on, pressure stall info) ---
CONFIG_PSI=y

# --- Energy model: already on, needed for EAS scheduling ---
CONFIG_ENERGY_MODEL=y

# --- Perf events: already on ---
CONFIG_PERF_EVENTS=y

# --- io_uring: already on (modern async I/O) ---
CONFIG_IO_URING=y

# --- WireGuard: already on (modern VPN) ---
CONFIG_WIREGUARD=y

# --- OverlayFS: already on (container support) ---
CONFIG_OVERLAY_FS=y

# --- BPF JIT: already always on ---
CONFIG_BPF_JIT_ALWAYS_ON=y

# --- Shadow Call Stack: already on (security hardening) ---
CONFIG_SHADOW_CALL_STACK=y

# --- MGLRU: ship OFF (kill switch via /sys/kernel/mm/lru_gen/enabled) ---
# Already CONFIG_LRU_GEN=y with CONFIG_LRU_GEN_ENABLED not set
# This is correct — MGLRU code is present but disabled at boot

# --- Stack protector: strong ---
CONFIG_STACKPROTECTOR_STRONG=y

# --- Randomize kernel stack offset ---
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_APEX_SYSFS=y

# --- Device-specific drivers (topaz/tapas) ---
# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC1020=m
CONFIG_FINGERPRINT_GOODIX_FOD=m
# Charger ICs
CONFIG_BQ2589X_CHARGER=m
CONFIG_CHARGER_SC8551=m
CONFIG_FG_SM5602=m
CONFIG_LN8000_CHARGER=m
CONFIG_NOPMI_CHARGER=m
# TCPC (Type-C Port Controller)
CONFIG_TCPC_CLASS=m
CONFIG_USB_POWER_DELIVERY=y
CONFIG_TCPC_RT1711H=m
CONFIG_DUAL_ROLE_USB_INTF=m
CONFIG_CHARGER_PD_POLICY=m
# Battery authentication
CONFIG_ONEWIRE_GPIO=m
CONFIG_BATT_VERIFY_BY_DS28E16=m
# ANT check
CONFIG_ANT_CHECK=m
CONFIG_ANT_CHECK_DIV=m
# MI thermal interface
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_APEX_CHARGE=m
