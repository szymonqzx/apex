# defconfig/charging.config — APEX Advanced Charging & Battery Management
#
# This fragment is merged into EVERY build (unlike profile-*.config which
# are mutually exclusive). It enables the APEX Charge Manager kernel module
# and ensures the Qualcomm PM7250B SMB5 charger, QG fuel gauge, and related
# power supply drivers are built-in.
#
# Hardware:
#   - Main charger:    PM7250B SMB5 (qcom,pm7250b-smb5)
#   - Parallel charger: SMB1355 (qcom,smb1355)
#   - Fuel gauge:      PM7250B QG
#   - USB PD:          PM7250B PD phy + RT1711H TCPC
#   - Battery:         5000 mAh Li-Po (BN5M), 4.35V max, 33W fast charge
#   - Protocol:        HVDCP3 (QC 3.0)

# APEX Charge Manager
CONFIG_APEX_CHARGE=y

# Qualcomm SMB5 charger driver (PM7250B)
CONFIG_CHARGER_SMB5=y

# Qualcomm QG fuel gauge
CONFIG_QG=y

# SMB1355 parallel charger
CONFIG_CHARGER_SMB1355=y

# Power supply class (required)
CONFIG_POWER_SUPPLY=y

# Battery sysfs class
CONFIG_BATTERY_BQ27XXX=n

# Qualcomm battery data
CONFIG_BATTERY_DATA=y

# USB Type-C support (RT1711H TCPC)
CONFIG_TYPEC=y
CONFIG_TYPEC_RT1711H=y

# USB Power Delivery
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_PD_PHY=y

# BCL (Battery Current Limit) — already in DT
CONFIG_QCOM_BCL=y

# Charger thermal mitigation via cooling device
CONFIG_THERMAL=y
