# apex-security.config — Pentest surface hardening
# Applied on top of apex-modern.config to reduce attack surface.
# All changes are config-level (no source patches needed).

# --- Control Flow Integrity ---
CONFIG_CFI_CLANG=y
# CONFIG_CFI_PERMISSIVE is not set

# --- BPF hardening ---
# Disable unprivileged BPF (kernel 5.15 default is still on)
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# --- Disable userfaultfd (heap spray attack vector) ---
# CONFIG_USERFAULTFD is not set

# --- Module randomization ---
CONFIG_RANDOMIZE_MODULE_REGION_FULL=y

# --- Restrict debugfs ---
# DEBUG_FS is selected by TRACING (ftrace) and PAGE_PINNER.
# We keep ftrace, so DEBUG_FS stays. Disable PAGE_PINNER to reduce one selector.
# CONFIG_PAGE_PINNER is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
# Disable EDAC (not needed on mobile, reduces attack surface)
# CONFIG_EDAC is not set

# --- Disable hibernation (attack surface + not needed on phone) ---
# CONFIG_HIBERNATION is not set
# CONFIG_HIBERNATION_SNAPSHOT_DEV is not set

# --- Restrict /proc/kallsyms exposure ---
# CONFIG_KALLSYMS_ALL is not set

# --- Lockdown LSM ---
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# CONFIG_LOCK_DOWN_IN_EFI_SECURE_LEVEL is not set

# --- Disable USB gadget debug endpoints ---
# CONFIG_USB_GADGET_DEBUG is not set
# CONFIG_USB_GADGET_DEBUG_FILES is not set
# CONFIG_USB_GADGET_DEBUG_FS is not set

# --- Restrict perf events ---
CONFIG_PERF_EVENTS=y
# CONFIG_PERF_EVENTS_DEBUG is not set

# --- Disable kexec (kernel replacement attack vector) ---
# Already disabled: CONFIG_KEXEC, CONFIG_KEXEC_FILE

# --- Fortify source ---
# NOTE: FORTIFY_SOURCE depends on !CC_IS_CLANG on 5.15 — cannot enable with Clang
# CONFIG_FORTIFY_SOURCE is not set

# --- SLAB freelist hardening ---
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y

# --- Refcount_t hardening ---
CONFIG_REFCOUNT_FULL=y

# --- Disable /dev/mem (already disabled on arm64 but be explicit) ---
# CONFIG_DEVMEM is not set
# CONFIG_DEVKMEM is not set

# --- Trustworthy RNG ---
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_RANDOMIZE_BASE=y
