# Scheduler: PREEMPT, HZ=250, WALT, CASS, EAS, PSI
# Combines the best of Sultan's CASS approach with CAF's WALT load tracking
# for optimal big.LITTLE task placement on the A73/A53 clusters.

CONFIG_PREEMPT=y
# CONFIG_PREEMPT_DYNAMIC is not set (requires HAVE_STATIC_CALL, not on arm64 5.15)
CONFIG_NO_HZ=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
# HZ=250 (HZ_200 doesn't exist in 5.15 Kconfig; 250 is closest, 4ms tick)
CONFIG_HZ_250=y
CONFIG_HZ=250

# WALT: Window Assisted Load Tracking — far better than PELT for bursty
# phone workloads. Feeds schedutil with windowed utilization data and
# brings input boost + core control for free.
CONFIG_SCHED_WALT=y
# CONFIG_SCHED_WALT_DEBUG is not set

# CASS: Capacity Aware Superset Scheduler — Sultan Alsawaf's runqueue
# selection optimizer. Uses CPU capacity for fair load balancing across
# asymmetric A73/A53 clusters. Better than explicit EAS for this SoC.
CONFIG_SCHED_CASS=y

# Energy Model for capacity-aware scheduling
CONFIG_ENERGY_MODEL=y

# Utilization clamping for per-task performance hints
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=20
CONFIG_UCLAMP_TASK_GROUP=y

# PSI for memory/CPU/IO pressure metrics
CONFIG_PSI=y

# Governor config is in governor.config (apex + schedutil).
# No duplicate governor entries here — merge_config.sh applies
# fragments alphabetically, so governor.config is authoritative.

# CPU idle: per-cluster drivers for independent power-down
CONFIG_CPU_IDLE=y
# CPU_IDLE_MULTIPLE_DRIVERS is auto-selected by ARM_CPUIDLE/ARM_PSCI_CPUIDLE
# (hidden bool, no prompt — setting it explicitly is harmless but unnecessary)
CONFIG_ARM_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_CPU_IDLE_THERMAL=y

# RT optimization
CONFIG_RT_SOFTINT_OPTIMIZATION=y

# Scheduler stats for debugging
CONFIG_SCHEDSTATS=y

# Fair group scheduling for cgroup-based task prioritization
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_SCHED_MC=y

# Power-efficient workqueues: route work to little cluster (A53) when
# possible on big.LITTLE. Reduces battery by avoiding big core (A73)
# wakeups for non-urgent work. From ChicKernel.
CONFIG_WQ_POWER_EFFICIENT=y

# Forced lazy RCU: defer grace periods to reduce idle wakeups.
# On a device that spends significant time with screen off, this
# reduces idle power consumption. Well-tested in 5.15+.
# From ChicKernel.
CONFIG_RCU_LAZY=y
CONFIG_RCU_LAZY_DEFAULT_GP=10
