# Display: KCAL color calibration
# Provides RGB gain adjustment for the MDSS display panel via sysfs.
# Exposes /sys/class/apex_kcal/rgb_gains for per-channel gain control.
# Inspired by Franco, ElementalX, and other custom kernels.
CONFIG_APEX_KCAL=y

# Display: BLX backlight dimmer
# Caps maximum brightness on battery for AMOLED power savings.
# Auto-removes cap when charging. Configurable via sysfs.
CONFIG_APEX_BLX=y
