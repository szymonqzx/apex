  },
  {
    "name": "apex_version",
    "command": "cat /proc/apex/version 2>/dev/null || echo unavailable",
    "timeout": 10,
    "byte_budget": 4096,
    "root": false,
    "description": "Apex kernel version",
    "category": "apex"
  },
  {
    "name": "apex_charge_status",
    "command": "cat /proc/apex_charge/status 2>/dev/null || echo unavailable",
    "timeout": 10,
