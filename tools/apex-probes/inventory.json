    "timeout": 10,
    "byte_budget": 1024,
    "root": false,
    "description": "Battery health status",
    "category": "battery"
  },
  {
    "name": "battery_technology",
    "command": "cat /sys/class/power_supply/battery/technology",
    "timeout": 10,
    "byte_budget": 1024,
    "root": false,
    "description": "Battery technology",
    "category": "battery"
  },
  {
