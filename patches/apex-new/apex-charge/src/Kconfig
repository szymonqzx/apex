# Fragment appended to drivers/apex/Kconfig by apply.sh (idempotent)
config APEX_CHARGE
	tristate "APEX charge limiting"
	depends on APEX_SYSFS && POWER_SUPPLY
	default m
	help
	  APEX charge limiting module. Stops charging at a user-set
	  battery percentage by braking the main charger's charge
	  current through the power_supply framework, re-asserting
	  periodically against the ROM's charger daemons, with 3%
	  hysteresis.

	  Exposes /sys/class/apex/charge/:
	    charge_limit_percent  - rw (0=disabled, 80-100)
	    status                - r  (JSON: limit, state, capacity,
	                                  temperature, voltage, current)

	  If unsure, say M.
