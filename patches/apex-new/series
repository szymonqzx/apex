# APEX kernel patch series
# Applied in order to the Zepharo R9 base (Linux 5.15.170)
#
# Format: <patch-name> <description>
# Patches are applied by tools/apply-patches.sh

# 1. APEX sysfs control plane — /sys/class/apex/ class
apex-sysfs           APEX sysfs class and version nodes

# 2. APEX charge limiting — /sys/class/apex/charge/ (real actuation)
apex-charge          APEX charge limiting (CURRENT_NOW brake + re-assert)

# 3. Baseband guard — LSM blocking writes to critical partitions
apex-baseband-guard  Anti-hard-brick partition write protection (LSM)

# 4. Device-specific driver backports from legacy kernel
#    Fingerprint, charger ICs, MI thermal, ANT check, battery auth
apex-device-backports  Topaz device drivers from legacy (fingerprint, chargers, thermal)

# 5. WALT SCHED_DEBUG guard — production builds disable SCHED_DEBUG
apex-walt-scheddebug  Guard sched_feat_names refs in walt_init() behind CONFIG_SCHED_DEBUG

# 6. Native root (KernelSU-Next) + SUSFS root hiding
apex-root          KernelSU-Next + SUSFS (path/mount/kstat/maps hiding)

# 7. Base-tree fixes (upstream bugs that break -Werror builds)
apex-base-fixes     Fix base-tree defects (minidump_log md_align_offset type, ...)
