# APEX overlay — append to /system/build.prop (dirty apply, no PIF module)
# Target ROM: LineageOS 23.2-20260328-UNOFFICIAL-tapas (Android 16 / AOSP 16 QPR2)
# Device: Redmi Note 12 4G (topaz/tapas, SM6225-AD)
#
# PIF strategy: spoof a stock Xiaomi MIUI build fingerprint that matches
# the device's hardware identity. Play Integrity DEVICE tier passes with
# a valid release-keys fingerprint + matching security patch. STRONG tier
# is handled by TrickyStore + Yurikey keybox (not build.prop).
#
# Source: Xiaomi MIUI V816.0.7.0.UMGMIXM global stable for topaz (Android 13,
# TKQ1.221114.001). This is the latest stock fingerprint that Play Integrity
# accepts for this device model. Using a newer MIUI fingerprint would require
# matching vendor partition state; using a LineageOS fingerprint would fail
# DEVICE tier because LineageOS builds are userdebug/debuggable.

# --- Build fingerprint (PIF core) ---
ro.build.fingerprint=Xiaomi/topaz_global/topaz:13/TKQ1.221114.001/V816.0.7.0.UMGMIXM:user/release-keys
ro.product.build.fingerprint=Xiaomi/topaz_global/topaz:13/TKQ1.221114.001/V816.0.7.0.UMGMIXM:user/release-keys

# --- Build type + keys (PIF: must be user/release-keys) ---
ro.build.type=user
ro.build.keys=release-keys
ro.debuggable=0
ro.secure=1

# --- Build ID + security patch (must match fingerprint) ---
ro.build.version.security_patch=2024-12-01
ro.system.build.id=TKQ1.221114.001
ro.system.build.tags=release-keys
ro.product.build.id=TKQ1.221114.001
ro.product.build.tags=release-keys

# --- SDK level (keep LineageOS 23.2 actual SDK — do NOT spoof) ---
# Android 16 = SDK 36. Play Integrity checks build fingerprint, not SDK
# level, for DEVICE tier. Keeping the real SDK prevents app compatibility
# breakage. The fingerprint spoof above is sufficient for DEVICE tier.
# ro.build.version.sdk=36  # DO NOT OVERRIDE — let LineageOS set this

# --- APEX internal ---
ro.apex.hide=1
ro.apex.version=1.2.0
ro.apex.rom_base=lineage-23.2

# --- Kill root prop leaks (belt + suspenders with SuSFS) ---
# These are also handled by SuSFS getprop filter, but we set them here
# too so that read-only properties match before SuSFS hooks load.
ro.boot.veritymode=enforcing
ro.boot.verifiedbootstate=yellow
