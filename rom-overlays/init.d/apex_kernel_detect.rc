# rom-overlays/init.d/apex_kernel_detect.rc
#
# Init script for APEX kernel detection at boot.
# Sets properties that Apex Control reads to display a badge/notice.
# The ROM WARNS (never refuses) when not running the APEX kernel.
#
# Brick-safety: read-only — only reads /proc/version and sets properties.

on early-boot
    # Read kernel version string
    exec - root system -- /system/bin/apex_kernel_detect.sh

on property:ro.apex.kernel=*
    # Apex Control reads this property to show/hide the APEX badge
    setprop ro.apex.kernel_detected ${ro.apex.kernel}
